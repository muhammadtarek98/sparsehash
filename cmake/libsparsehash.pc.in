prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: @PROJECT_NAME@
Description: hash_map and hash_set classes with minimal space overhead
URL: @PACKAGE_URL@
Version: @PROJECT_VERSION@
Libs:
Cflags: -I${includedir}
